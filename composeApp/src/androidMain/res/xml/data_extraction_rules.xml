<?xml version="1.0" encoding="utf-8"?>
<!--
    PhysioApp stores personal health data locally. Until a backup/restore policy is approved
    (docs/00-auditoria-y-plan.md, D-backups), nothing may leave the device: neither Android's
    cloud backup nor device-to-device transfer. android:allowBackup="false" covers Android 11 and
    lower; these rules cover Android 12+ (API 31+), where allowBackup alone does not stop D2D.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
