<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
             Auto-captures the host app's Context for KVault (secure storage), without requiring
             the app module to wire a Koin androidContext() call. See
             com.connectapp.core.storage.KVaultContextInitializer.
        -->
        <provider
            android:name="com.connectapp.core.storage.KVaultContextInitializer"
            android:authorities="${applicationId}.connectapp.core.storage.context-initializer"
            android:exported="false" />
    </application>

</manifest>
